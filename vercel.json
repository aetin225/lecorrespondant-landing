{
  "outputDirectory": ".",
  "functions": {
    "api/demo.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/demo", "destination": "/api/demo.js" },
    { "source": "/cgu", "destination": "/cgu.html" },
    { "source": "/confidentialite", "destination": "/confidentialite.html" },
    { "source": "/cookies", "destination": "/cookies.html" },
    { "source": "/((?!api|cgu|confidentialite|cookies).*)", "destination": "/index.html" }
  ]
}
