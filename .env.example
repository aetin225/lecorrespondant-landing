# === Configuration SMTP (à renseigner dans Vercel > Settings > Environment Variables) ===

# Serveur SMTP
SMTP_HOST=mail.votredomaine.ci
SMTP_PORT=587
SMTP_USER=contact@lecorrespondant.ci
SMTP_PASS=votre_mot_de_passe_smtp

# Expéditeur (souvent identique à SMTP_USER)
SMTP_FROM=contact@lecorrespondant.ci

# Destinataires de la demande de démo (séparés par des virgules)
SMTP_TO=contact@lecorrespondant.ci,contact@sms-ci.net
