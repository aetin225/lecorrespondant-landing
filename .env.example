# À renseigner dans Vercel > Settings > Environment Variables (Production).
# Aucun secret ne doit être placé dans public/.
SITE_URL=https://lecorrespondant.ci
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=contact@lecorrespondant.ci
SMTP_PASS=
SMTP_FROM=contact@lecorrespondant.ci
SMTP_TO=contact@sms-ci.net

# SMTP_PASSWORD est également accepté pour compatibilité avec l'ancien projet.
# Le port 587 exige STARTTLS ; le port 465 utilise TLS dès la connexion.
